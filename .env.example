# Secrets for the proposal pipeline. Copy to .env (git-ignored),
# or run `python3 -m proposal_pipeline setup`.
# Variables already set in your shell take precedence over this file.

# Semantic Scholar API key, used by stage 04 (search).
# Request one at https://www.semanticscholar.org/product/api#api-key-form
# Without a key, the shared public rate limit applies and searches may fail.
SEMANTIC_SCHOLAR_API_KEY=

# Contact e-mail for the Unpaywall API, used by stage 05 (download).
# No registration is needed; Unpaywall only asks for an e-mail address.
UNPAYWALL_EMAIL=
